{
  "mcpServers": {
    "langmcp": {
      "command": "uvx",
      "args": ["langmcp[all]", "serve", "--config", "/absolute/path/to/langmcp.toml"],
      "env": {
        "LANGMCP_READ_ONLY": "true",
        "POSTGRES_URI": "postgresql://langgraph:langgraph@localhost:5442/langgraph"
      }
    }
  }
}
