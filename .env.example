# LangMCP environment example.
# Copy to .env for local development. Never commit a real .env file.

# Optional path to a config file. If unset, LangMCP looks for ./langmcp.toml
# and then ~/.langmcp.toml.
LANGMCP_CONFIG=./langmcp.toml

# Optional active profile override.
LANGMCP_PROFILE=dev

# v0.1 is read-only by design.
LANGMCP_READ_ONLY=true

# PostgreSQL URI used by examples/langmcp.example.toml.
# Use a read-only database user for shared dev, staging, or production inspection.
POSTGRES_URI=postgresql://READONLY_USER:READONLY_PASSWORD@HOST:5432/DB_NAME

# Optional direct URI overrides. Usually leave these empty and use langmcp.toml.
LANGMCP_CHECKPOINTER_URI=
LANGMCP_STORE_URI=

# Optional Redis URI for Redis checkpoint inspection.
REDIS_URI=redis://HOST:6379/0
